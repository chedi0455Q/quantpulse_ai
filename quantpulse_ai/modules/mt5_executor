import logging
from typing import Dict, Any, Optional

try:
    import MetaTrader5 as mt5
    MT5_AVAILABLE = True
except (ImportError, ModuleNotFoundError, Exception):
    mt5 = None
    MT5_AVAILABLE = False

from config.settings import settings

logger = logging.getLogger(__name__)

class MT5Executor:
    """
    Automated Order Execution Engine for MetaTrader 4 / MetaTrader 5.
    Executes high-confidence Day Trading signals directly on Demo / Real accounts.
    """

    def __init__(self):
        self.is_connected = False
        self._initialize_mt5()

    def _initialize_mt5(self):
        """Check and initialize MetaTrader 5 connection."""
        if MT5_AVAILABLE and mt5:
            try:
                if mt5.initialize():
                    self.is_connected = True
                    account_info = mt5.account_info()
                    if account_info:
                        logger.info(f"✅ MT5 Auto-Trader connecté au compte Démo #{account_info.login} (Solde: {account_info.balance} {account_info.currency})")
                else:
                    logger.warning(f"Échec connexion MT5 Auto-Trader: {mt5.last_error()}")
            except Exception as e:
                logger.warning(f"Erreur initialisation MT5 Auto-Trader: {e}")

    def check_risk_limits(self, max_daily_loss_pct: float = 3.0, max_total_loss_pct: float = 10.0) -> Dict[str, Any]:
        """
        Calculates Daily Drawdown and Total Drawdown on MT5 account.
        - Daily Loss Limit: Default -3.0% max loss per day.
        - Total Loss Limit: Default -10.0% max loss total.
        """
        if not MT5_AVAILABLE or not mt5 or not self.is_connected:
            return {"allowed": True, "reason": "MT5 non connecté"}

        acc = mt5.account_info()
        if not acc:
            return {"allowed": True, "reason": "Informations compte indisponibles"}

        initial_balance = acc.balance
        equity = acc.equity

        # Total Drawdown check
        total_loss_pct = ((equity - initial_balance) / initial_balance) * 100.0
        if total_loss_pct <= -max_total_loss_pct:
            return {
                "allowed": False,
                "reason": f"🚨 LIMITE DE PERTE TOTALE ATTEINTE ({total_loss_pct:.1f}% <= -{max_total_loss_pct}%). Auto-Trading désactivé d'urgence !",
                "is_total": True
            }

        # Daily Drawdown check (P&L today)
        import datetime
        today_start = datetime.datetime.now().replace(hour=0, minute=0, second=0, microsecond=0)
        history = mt5.history_deals_get(today_start, datetime.datetime.now())
        
        daily_pnl = 0.0
        if history:
            for deal in history:
                daily_pnl += deal.profit + deal.swap + deal.commission

        daily_loss_pct = (daily_pnl / initial_balance) * 100.0
        if daily_loss_pct <= -max_daily_loss_pct:
            return {
                "allowed": False,
                "reason": f"🛑 LIMITE DE PERTE JOURNALIÈRE ATTEINTE ({daily_loss_pct:.1f}% <= -{max_daily_loss_pct}%). Auto-Trading suspendu pour aujourd'hui.",
                "is_daily": True
            }

        return {"allowed": True, "daily_loss_pct": daily_loss_pct, "total_loss_pct": total_loss_pct}

    def execute_auto_trade(self, eval_data: Dict[str, Any]) -> Dict[str, Any]:
        """
        Executes a 100% automated trade on MT5 with exact Lot size, TP1, TP2, and SL.
        Respects Daily Loss Limit (-3%) and Total Loss Limit (-10%).
        """
        if not MT5_AVAILABLE or not mt5 or not self.is_connected:
            return {
                "success": False,
                "message": "MT5 non disponible sur cet environnement (Nécessite terminal MT5 sur PC local)."
            }

        # 0. Check Risk Guardrails (Daily Loss & Total Loss Limits)
        risk_chk = self.check_risk_limits(max_daily_loss_pct=3.0, max_total_loss_pct=10.0)
        if not risk_chk.get("allowed", True):
            return {
                "success": False,
                "message": risk_chk.get("reason", "Limite de risque atteinte.")
            }

        asset_key = eval_data.get("asset_key")
        action = eval_data.get("final_action")
        price = eval_data.get("price")
        tp1 = eval_data.get("tp1")
        tp2 = eval_data.get("tp2")
        sl = eval_data.get("sl")
        lot_size = eval_data.get("recommended_lot", 0.11)

        if action not in ["BUY", "SELL"]:
            return {"success": False, "message": "Action neutre - Aucun ordre à exécuter."}

        # Symbol Mapping for MT5 Brokers
        symbol_map = {
            "XAU": ["XAUUSD", "GOLD", "XAUUSD.a", "XAUUSD.m", "XAUUSD.ecn"],
            "XAG": ["XAGUSD", "SILVER", "XAGUSD.a", "XAGUSD.m"],
            "BTC": ["BTCUSD", "BTCUSDT"],
            "TSLA": ["TSLA"]
        }
        candidates = symbol_map.get(asset_key, [asset_key])
        
        target_symbol = None
        for sym in candidates:
            info = mt5.symbol_info(sym)
            if info is not None:
                if not info.visible:
                    mt5.symbol_select(sym, True)
                target_symbol = sym
                break

        if not target_symbol:
            return {"success": False, "message": f"Symbole MT5 introuvable pour {asset_key}."}

        # Determine Order Type & Prices
        tick = mt5.symbol_info_tick(target_symbol)
        if not tick:
            return {"success": False, "message": f"Impossible d'obtenir le tick en direct pour {target_symbol}."}

        order_type = mt5.ORDER_TYPE_BUY if action == "BUY" else mt5.ORDER_TYPE_SELL
        entry_price = tick.ask if action == "BUY" else tick.bid

        # Request structure
        request = {
            "action": mt5.TRADE_ACTION_DEAL,
            "symbol": target_symbol,
            "volume": float(lot_size),
            "type": order_type,
            "price": float(entry_price),
            "sl": float(sl),
            "tp": float(tp2),  # Target TP2 (Ratio 1:3)
            "deviation": 20,
            "magic": 202608,
            "comment": "QuantPulse AI Auto-Trader",
            "type_time": mt5.ORDER_TIME_GTC,
            "type_filling": mt5.ORDER_FILLING_IOC,
        }

        # Execute Order on MT5
        result = mt5.order_send(request)
        if result and result.retcode == mt5.TRADE_RETCODE_DONE:
            logger.info(f"🚀 ORDRE MT5 EXÉCUTÉ ! Ticket #{result.order} | {action} {lot_size} {target_symbol} à {entry_price} | TP: {tp2} | SL: {sl}")
            return {
                "success": True,
                "ticket": result.order,
                "symbol": target_symbol,
                "action": action,
                "lot": lot_size,
                "price": entry_price,
                "tp": tp2,
                "sl": sl,
                "message": f"Ordre #{result.order} exécuté avec succès sur MT5 !"
            }
        else:
            error_code = result.retcode if result else "Inconnu"
            error_desc = result.comment if result else mt5.last_error()
            logger.error(f"❌ Échec exécution ordre MT5: Code {error_code} - {error_desc}")
            return {
                "success": False,
                "error_code": error_code,
                "message": f"Échec MT5: {error_desc}"
            }
